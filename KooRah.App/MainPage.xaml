<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:KooRah.App.Services"
             x:Class="KooRah.App.MainPage"
             BackgroundColor="#10151B"
             FlowDirection="RightToLeft"
             Title="KooRah">

    <!-- Hero Map full-screen with floating interactive cards -->
    <Grid BackgroundColor="#10151B">

        <!-- Full-Bleed Map Hero Layer -->
        <WebView x:Name="MapView"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Navigating="OnMapViewNavigating" />

        <!-- TOP: Floating Search, Saved Places & Status Card -->
        <VerticalStackLayout x:Name="TopSearchCard"
                             VerticalOptions="Start"
                             Margin="16, 20, 16, 0"
                             Spacing="6">

            <!-- Search Panel Border -->
            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="1"
                    Stroke="#222C38"
                    BackgroundColor="#1B232C"
                    Padding="14, 12">
                <Border.Shadow>
                    <Shadow Brush="#080C10"
                            Offset="0, 8"
                            Radius="20"
                            Opacity="0.65" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <!-- Status Header Indicator + Saved Places Quick Access Button -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <!-- Status Dot & Network Status -->
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Ellipse x:Name="StatusDot"
                                     WidthRequest="8"
                                     HeightRequest="8"
                                     Fill="#8B96A3"
                                     VerticalOptions="Center" />
                            <Label x:Name="StatusLabel"
                                   Text="Loading road network..."
                                   FontFamily="Manrope"
                                   FontSize="12"
                                   TextColor="#8B96A3"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Saved Places Manager Toggle Button -->
                        <Button x:Name="SavedPlacesSheetButton"
                                Grid.Column="1"
                                Text="⭐ نشان‌شده‌ها"
                                FontFamily="Manrope"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#23A6A0"
                                BackgroundColor="#151D25"
                                BorderColor="#26313E"
                                BorderWidth="1"
                                CornerRadius="12"
                                HeightRequest="30"
                                Padding="10, 0"
                                Clicked="OnOpenSavedPlacesModalClicked" />
                    </Grid>

                    <!-- Route Endpoints Interactive Section -->
                    <Grid ColumnDefinitions="22, *, 42" RowDefinitions="Auto, Auto" RowSpacing="8" ColumnSpacing="8">

                        <!-- Column 0: Visual Route Connector Line (Green Dot -> Dotted Track -> Red Pin) -->
                        <Grid Grid.Column="0" Grid.RowSpan="2" HorizontalOptions="Center" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                <!-- Origin Dot (Teal/Green) -->
                                <Ellipse WidthRequest="9"
                                         HeightRequest="9"
                                         Fill="#23A6A0"
                                         HorizontalOptions="Center" />
                                <!-- Dotted Connection Track -->
                                <BoxView WidthRequest="2"
                                         HeightRequest="28"
                                         Color="#334253"
                                         HorizontalOptions="Center" />
                                <!-- Destination Pin (Coral/Red) -->
                                <Ellipse WidthRequest="9"
                                         HeightRequest="9"
                                         Fill="#EF4444"
                                         HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Column 1, Row 0: Origin Search Row with Clear Button -->
                        <Border Grid.Column="1"
                                Grid.Row="0"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#26313E"
                                BackgroundColor="#10151B"
                                Padding="10, 0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="OriginEntry"
                                       Grid.Column="0"
                                       Placeholder="مبدا (جستجوی آدرس یا موقعیت فعلی)"
                                       PlaceholderColor="#5F6D7E"
                                       TextColor="#EDEFF2"
                                       FontFamily="Manrope"
                                       FontSize="13"
                                       HeightRequest="38"
                                       TextChanged="OnOriginTextChanged"
                                       Focused="OnOriginFocused" />
                                <Button x:Name="ClearOriginButton"
                                        Grid.Column="1"
                                        Text="✕"
                                        FontSize="12"
                                        TextColor="#8B96A3"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        Padding="0"
                                        IsVisible="False"
                                        Clicked="OnClearOriginClicked" />
                            </Grid>
                        </Border>

                        <!-- Column 2, Row 0: GPS Locate Me button -->
                        <Button x:Name="LocateMeButton"
                                Grid.Column="2"
                                Grid.Row="0"
                                Text="⌖"
                                ToolTipProperties.Text="Use My GPS Location"
                                FontFamily="Manrope"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#23A6A0"
                                BackgroundColor="#10151B"
                                BorderColor="#26313E"
                                BorderWidth="1"
                                CornerRadius="12"
                                WidthRequest="40"
                                HeightRequest="38"
                                Padding="0"
                                Clicked="OnLocateMeClicked" />

                        <!-- Column 1, Row 1: Destination Search Row with Clear Button -->
                        <Border Grid.Column="1"
                                Grid.Row="1"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#26313E"
                                BackgroundColor="#10151B"
                                Padding="10, 0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="DestinationEntry"
                                       Grid.Column="0"
                                       Placeholder="مقصد (جستجوی آدرس یا نام مکان)"
                                       PlaceholderColor="#5F6D7E"
                                       TextColor="#EDEFF2"
                                       FontFamily="Manrope"
                                       FontSize="13"
                                       HeightRequest="38"
                                       TextChanged="OnDestinationTextChanged"
                                       Focused="OnDestinationFocused" />
                                <Button x:Name="ClearDestinationButton"
                                        Grid.Column="1"
                                        Text="✕"
                                        FontSize="12"
                                        TextColor="#8B96A3"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        Padding="0"
                                        IsVisible="False"
                                        Clicked="OnClearDestinationClicked" />
                            </Grid>
                        </Border>

                        <!-- Column 2, Row 1: Swap Endpoints Button (⇄ / ⇅) -->
                        <Button x:Name="SwapEndpointsButton"
                                Grid.Column="2"
                                Grid.Row="1"
                                Text="⇅"
                                ToolTipProperties.Text="Swap Origin and Destination"
                                FontFamily="Manrope"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#EDEFF2"
                                BackgroundColor="#10151B"
                                BorderColor="#26313E"
                                BorderWidth="1"
                                CornerRadius="12"
                                WidthRequest="40"
                                HeightRequest="38"
                                Padding="0"
                                Clicked="OnSwapEndpointsClicked" />
                    </Grid>

                    <!-- Quick Access Saved Places Horizontal Chip Bar -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalOptions="Center"
                                Margin="0, 2, 0, 0">
                        <HorizontalStackLayout x:Name="SavedPlacesChipsLayout"
                                               Spacing="6"
                                               VerticalOptions="Center">
                            <!-- Injected dynamically in C# + "+ New Place" button -->
                        </HorizontalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>

            <!-- Floating Suggestions Dropdown List with Bookmark Star Action -->
            <Border x:Name="SuggestionsBorder"
                    IsVisible="False"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="#222C38"
                    BackgroundColor="#1B232C"
                    Padding="6, 6"
                    MaximumHeightRequest="240">
                <Border.Shadow>
                    <Shadow Brush="#05080C"
                            Offset="0, 8"
                            Radius="20"
                            Opacity="0.75" />
                </Border.Shadow>

                <CollectionView x:Name="SuggestionsCollection"
                                SelectionMode="Single"
                                SelectionChanged="OnSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:PlaceSearchResult">
                            <Border StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent"
                                    Padding="10, 8"
                                    Margin="0, 2">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#242F3B" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontFamily="Manrope"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#EDEFF2" />
                                        <Label Text="{Binding DisplayAddress}"
                                               FontFamily="Manrope"
                                               FontSize="11"
                                               TextColor="#8B96A3"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Quick Bookmark Star button -->
                                    <Button Grid.Column="1"
                                            Text="⭐"
                                            FontSize="14"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Padding="0"
                                            ToolTipProperties.Text="ذخیره این مکان"
                                            Clicked="OnBookmarkSuggestionClicked"
                                            BindingContext="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>

        <!-- Floating Re-center Button (Google Maps Style: Appears when user pans away during navigation) -->
        <Button x:Name="RecenterButton"
                Text="⌖ مرکز نقشه"
                FontFamily="Manrope"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#23A6A0"
                BackgroundColor="#1B232C"
                BorderColor="#23A6A0"
                BorderWidth="1.5"
                CornerRadius="24"
                HeightRequest="44"
                Padding="22, 0"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0, 0, 0, 245"
                IsVisible="False"
                Clicked="OnRecenterClicked">
            <Button.Shadow>
                <Shadow Brush="#05080C"
                        Offset="0, 6"
                        Radius="16"
                        Opacity="0.75" />
            </Button.Shadow>
        </Button>

        <!-- BOTTOM: Floating Route & ETA Sheet Card -->
        <Border HorizontalOptions="Fill"
                VerticalOptions="End"
                Margin="16, 0, 16, 24"
                Padding="18, 16"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="1"
                Stroke="#222C38"
                BackgroundColor="#1B232C">
            <Border.Shadow>
                <Shadow Brush="#080C10"
                        Offset="0, 8"
                        Radius="24"
                        Opacity="0.65" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">
                <!-- Overview Panel (Idle & Route Calculated) -->
                <VerticalStackLayout x:Name="OverviewPanel" Spacing="12">
                    <!-- Metrics Row: Big ETA on left, Distance on right -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label x:Name="EtaLabel"
                                   Text="-- دقیقه"
                                   FontFamily="SpaceGrotesk"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   TextColor="#EDEFF2" />
                            <Label x:Name="AlgorithmDetailsLabel"
                                   Text="مبدا و مقصد را انتخاب کنید"
                                   FontFamily="Manrope"
                                   FontSize="12"
                                   TextColor="#8B96A3" />
                        </VerticalStackLayout>

                        <Label x:Name="DistanceLabel"
                               Grid.Column="1"
                               Text=""
                               FontFamily="Manrope"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#EDEFF2"
                               VerticalOptions="Start"
                               Margin="0, 6, 0, 0" />
                    </Grid>

                    <!-- Route Quality Badges (Live Traffic & Fast Route tags) -->
                    <HorizontalStackLayout x:Name="RouteBadgesLayout" Spacing="8" IsVisible="False">
                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="#15322F"
                                Stroke="#1A4A45"
                                StrokeThickness="1"
                                Padding="8, 3">
                            <Label Text="⚡ سریع‌ترین مسیر"
                                   FontFamily="Manrope"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#38D9CE" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="#1B2836"
                                Stroke="#263A4D"
                                StrokeThickness="1"
                                Padding="8, 3">
                            <Label Text="🟢 ترافیک زنده TomTom"
                                   FontFamily="Manrope"
                                   FontSize="11"
                                   TextColor="#8B96A3" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Amber delay/warning label -->
                    <Label x:Name="WarningLabel"
                           Text=""
                           FontFamily="Manrope"
                           FontSize="12"
                           TextColor="#E0A458"
                           IsVisible="False" />

                    <!-- Dual Action Buttons Row: Find Route + Save Destination -->
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Button x:Name="FindRouteButton"
                                Grid.Column="0"
                                Text="مسیریابی"
                                FontFamily="Manrope"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#10151B"
                                BackgroundColor="#23A6A0"
                                CornerRadius="16"
                                HeightRequest="50"
                                Clicked="OnFindRouteClicked"
                                IsEnabled="False" />

                        <!-- Save Destination to Saved Places Shortcut Button -->
                        <Button x:Name="SaveDestinationButton"
                                Grid.Column="1"
                                Text="⭐ ذخیره"
                                ToolTipProperties.Text="ذخیره این مکان در نشان‌شده‌ها"
                                FontFamily="Manrope"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#EDEFF2"
                                BackgroundColor="#222C38"
                                BorderColor="#334253"
                                BorderWidth="1"
                                CornerRadius="16"
                                HeightRequest="50"
                                Padding="16, 0"
                                Clicked="OnSaveCurrentDestinationClicked"
                                IsEnabled="False" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Active Navigation Panel (Google Maps Style) -->
                <Grid x:Name="ActiveNavPanel"
                      ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="14"
                      VerticalOptions="Center"
                      IsVisible="False">
                    <!-- Exit Navigation Circular Button -->
                    <Button x:Name="ExitNavButton"
                            Grid.Column="0"
                            Text="✕"
                            FontFamily="Manrope"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#EDEFF2"
                            BackgroundColor="#26313E"
                            BorderColor="#334253"
                            BorderWidth="1"
                            CornerRadius="24"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            Clicked="OnExitNavClicked" />

                    <!-- Live Navigation ETA & Arrival -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label x:Name="NavEtaLabel"
                               Text="-- دقیقه"
                               FontFamily="SpaceGrotesk"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#23A6A0" />
                        <Label x:Name="NavDetailsLabel"
                               Text="-- کیلومتر • --:--"
                               FontFamily="Manrope"
                               FontSize="13"
                               TextColor="#8B96A3" />
                    </VerticalStackLayout>

                    <!-- Vehicle Switcher Button -->
                    <Button x:Name="VehicleSwitchButton"
                            Grid.Column="2"
                            Text="🚗"
                            ToolTipProperties.Text="Switch 3D Car Model"
                            FontSize="20"
                            BackgroundColor="#26313E"
                            BorderColor="#334253"
                            BorderWidth="1"
                            CornerRadius="24"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            Clicked="OnVehicleSwitchClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- POPUP MODAL: Saved Places Management Sheet -->
        <Grid x:Name="SavedPlacesModal"
              IsVisible="False"
              BackgroundColor="#B305080C"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- Backdrop Tap to dismiss -->
            <BoxView BackgroundColor="Transparent"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseSavedPlacesClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Centered Modal Content Card -->
            <Border StrokeShape="RoundRectangle 24"
                    StrokeThickness="1"
                    Stroke="#2A3746"
                    BackgroundColor="#171F27"
                    Padding="20"
                    Margin="18, 40, 18, 40"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="480"
                    MaximumHeightRequest="680">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0, 10"
                            Radius="28"
                            Opacity="0.8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="⭐" FontSize="18" VerticalOptions="Center" />
                            <Label Text="مکان‌های ذخیره‌شده"
                                   FontFamily="Manrope"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#EDEFF2"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Close Button -->
                        <Button Grid.Column="1"
                                Text="✕"
                                FontFamily="Manrope"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#8B96A3"
                                BackgroundColor="#222C38"
                                BorderColor="#2E3B4B"
                                BorderWidth="1"
                                CornerRadius="16"
                                WidthRequest="32"
                                HeightRequest="32"
                                Padding="0"
                                Clicked="OnCloseSavedPlacesClicked" />
                    </Grid>

                    <!-- Tab Separator -->
                    <BoxView HeightRequest="1" Color="#222C38" HorizontalOptions="Fill" />

                    <!-- Saved Places List -->
                    <Label Text="مکان‌های ثبت‌شده:"
                           FontFamily="Manrope"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#8B96A3" />

                    <Border StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="#222C38"
                            BackgroundColor="#11171E"
                            Padding="4, 4"
                            HeightRequest="190">
                        <CollectionView x:Name="SavedPlacesCollectionView"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                                    <Label Text="📍" FontSize="26" HorizontalOptions="Center" />
                                    <Label Text="هنوز مکانی ذخیره نشده است"
                                           FontFamily="Manrope"
                                           FontSize="12"
                                           TextColor="#5F6D7E"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="services:SavedPlace">
                                    <Border StrokeShape="RoundRectangle 10"
                                            StrokeThickness="1"
                                            Stroke="#1E2833"
                                            BackgroundColor="#171F27"
                                            Padding="10, 8"
                                            Margin="4, 3">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <!-- Icon -->
                                            <Label Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="20"
                                                   VerticalOptions="Center" />

                                            <!-- Label & Address -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Label}"
                                                       FontFamily="Manrope"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#EDEFF2" />
                                                <Label Text="{Binding DisplaySubtitle}"
                                                       FontFamily="Manrope"
                                                       FontSize="11"
                                                       TextColor="#8B96A3"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <!-- Navigate To Button -->
                                            <Button Grid.Column="2"
                                                    Text="مسیریابی"
                                                    FontFamily="Manrope"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#10151B"
                                                    BackgroundColor="#23A6A0"
                                                    CornerRadius="10"
                                                    HeightRequest="32"
                                                    Padding="10, 0"
                                                    Clicked="OnNavigateToSavedPlaceClicked"
                                                    BindingContext="{Binding .}" />

                                            <!-- Delete Button -->
                                            <Button Grid.Column="3"
                                                    Text="🗑"
                                                    FontSize="13"
                                                    TextColor="#E06C75"
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    Padding="0"
                                                    Clicked="OnDeleteSavedPlaceClicked"
                                                    BindingContext="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <!-- Add New Place Section -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="افزودن مکان جدید:"
                               FontFamily="Manrope"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#23A6A0" />

                        <!-- Custom Name Entry -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#26313E"
                                BackgroundColor="#10151B"
                                Padding="10, 2">
                            <Entry x:Name="NewPlaceLabelEntry"
                                   Placeholder="نام مکان (مثلاً خانه، باشگاه، شرکت، کافه)"
                                   PlaceholderColor="#5F6D7E"
                                   TextColor="#EDEFF2"
                                   FontFamily="Manrope"
                                   FontSize="13"
                                   HeightRequest="38" />
                        </Border>

                        <!-- Icon Category Selection Row -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="انتخاب آیکون:"
                                   FontFamily="Manrope"
                                   FontSize="11"
                                   TextColor="#8B96A3" />
                            <HorizontalStackLayout x:Name="IconPickerLayout" Spacing="6" HorizontalOptions="Center">
                                <Button Text="🏠" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="10" BackgroundColor="#222C38" BorderColor="#23A6A0" BorderWidth="1.5" Clicked="OnIconOptionClicked" />
                                <Button Text="💼" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="10" BackgroundColor="#171F27" BorderColor="#2E3B4B" BorderWidth="1" Clicked="OnIconOptionClicked" />
                                <Button Text="🏋️" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="10" BackgroundColor="#171F27" BorderColor="#2E3B4B" BorderWidth="1" Clicked="OnIconOptionClicked" />
                                <Button Text="☕" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="10" BackgroundColor="#171F27" BorderColor="#2E3B4B" BorderWidth="1" Clicked="OnIconOptionClicked" />
                                <Button Text="🎓" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="10" BackgroundColor="#171F27" BorderColor="#2E3B4B" BorderWidth="1" Clicked="OnIconOptionClicked" />
                                <Button Text="🛒" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="10" BackgroundColor="#171F27" BorderColor="#2E3B4B" BorderWidth="1" Clicked="OnIconOptionClicked" />
                                <Button Text="⭐" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="10" BackgroundColor="#171F27" BorderColor="#2E3B4B" BorderWidth="1" Clicked="OnIconOptionClicked" />
                                <Button Text="📍" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" CornerRadius="10" BackgroundColor="#171F27" BorderColor="#2E3B4B" BorderWidth="1" Clicked="OnIconOptionClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Location Source Selector -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0, 4, 0, 0">
                            <Button x:Name="SourceDestinationButton"
                                    Grid.Column="0"
                                    Text="مقصد فعلی"
                                    FontFamily="Manrope"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#EDEFF2"
                                    BackgroundColor="#222C38"
                                    BorderColor="#23A6A0"
                                    BorderWidth="1.5"
                                    CornerRadius="12"
                                    HeightRequest="36"
                                    Clicked="OnSourceDestinationClicked" />

                            <Button x:Name="SourceGpsButton"
                                    Grid.Column="1"
                                    Text="موقعیت فعلی من"
                                    FontFamily="Manrope"
                                    FontSize="11"
                                    TextColor="#8B96A3"
                                    BackgroundColor="#171F27"
