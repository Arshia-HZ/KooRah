<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:KooRah.App.Services"
             x:Class="KooRah.App.MainPage"
             BackgroundColor="#10151B"
             Title="KooRah">

    <!-- Hero Map full-screen with floating interactive cards -->
    <Grid BackgroundColor="#10151B">

        <!-- Full-Bleed Map Hero Layer -->
        <WebView x:Name="MapView"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Navigating="OnMapViewNavigating" />

        <!-- TOP: Floating Search & Status Card -->
        <VerticalStackLayout x:Name="TopSearchCard"
                             VerticalOptions="Start"
                             Margin="16, 20, 16, 0"
                             Spacing="6">

            <!-- Search Panel Border -->
            <Border StrokeShape="RoundRectangle 18"
                    StrokeThickness="1"
                    Stroke="#222C38"
                    BackgroundColor="#1B232C"
                    Padding="14, 12">
                <Border.Shadow>
                    <Shadow Brush="#080C10"
                            Offset="0, 6"
                            Radius="18"
                            Opacity="0.6" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="8">
                    <!-- Status Header Indicator -->
                    <Grid ColumnDefinitions="Auto, *">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Ellipse x:Name="StatusDot"
                                     WidthRequest="8"
                                     HeightRequest="8"
                                     Fill="#8B96A3"
                                     VerticalOptions="Center" />
                            <Label x:Name="StatusLabel"
                                   Text="Loading road network..."
                                   FontFamily="Manrope"
                                   FontSize="12"
                                   TextColor="#8B96A3"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Origin Search Row with GPS Locate button -->
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#26313E"
                                BackgroundColor="#10151B"
                                Padding="10, 2">
                            <Entry x:Name="OriginEntry"
                                   Placeholder="مبدا"
                                   PlaceholderColor="#5F6D7E"
                                   TextColor="#EDEFF2"
                                   FontFamily="Manrope"
                                   FontSize="13"
                                   HeightRequest="38"
                                   TextChanged="OnOriginTextChanged"
                                   Focused="OnOriginFocused" />
                        </Border>

                        <Button x:Name="LocateMeButton"
                                Grid.Column="1"
                                Text="⌖"
                                ToolTipProperties.Text="Use My GPS Location"
                                FontFamily="Manrope"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#23A6A0"
                                BackgroundColor="#10151B"
                                BorderColor="#26313E"
                                BorderWidth="1"
                                CornerRadius="12"
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0"
                                Clicked="OnLocateMeClicked" />
                    </Grid>

                    <!-- Destination Search Row -->
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="#26313E"
                            BackgroundColor="#10151B"
                            Padding="10, 2">
                        <Entry x:Name="DestinationEntry"
                               Placeholder="مقصد"
                               PlaceholderColor="#5F6D7E"
                               TextColor="#EDEFF2"
                               FontFamily="Manrope"
                               FontSize="13"
                               HeightRequest="38"
                               TextChanged="OnDestinationTextChanged"
                               Focused="OnDestinationFocused" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Floating Suggestions Dropdown List -->
            <Border x:Name="SuggestionsBorder"
                    IsVisible="False"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="#222C38"
                    BackgroundColor="#1B232C"
                    Padding="6, 6"
                    MaximumHeightRequest="220">
                <Border.Shadow>
                    <Shadow Brush="#05080C"
                            Offset="0, 8"
                            Radius="20"
                            Opacity="0.75" />
                </Border.Shadow>

                <CollectionView x:Name="SuggestionsCollection"
                                SelectionMode="Single"
                                SelectionChanged="OnSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:PlaceSearchResult">
                            <Border StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent"
                                    Padding="10, 8"
                                    Margin="0, 2">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#242F3B" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontFamily="Manrope"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#EDEFF2" />
                                    <Label Text="{Binding DisplayAddress}"
                                           FontFamily="Manrope"
                                           FontSize="11"
                                           TextColor="#8B96A3"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>

        <!-- Floating Re-center Button (Google Maps Style: Appears when user pans away during navigation) -->
        <Button x:Name="RecenterButton"
                Text="⌖ Re-center"
                FontFamily="Manrope"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#23A6A0"
                BackgroundColor="#1B232C"
                BorderColor="#23A6A0"
                BorderWidth="1.5"
                CornerRadius="24"
                HeightRequest="44"
                Padding="22, 0"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0, 0, 0, 134"
                IsVisible="False"
                Clicked="OnRecenterClicked">
            <Button.Shadow>
                <Shadow Brush="#05080C"
                        Offset="0, 6"
                        Radius="16"
                        Opacity="0.75" />
            </Button.Shadow>
        </Button>

        <!-- BOTTOM: Floating Route & ETA Sheet Card -->
        <Border HorizontalOptions="Fill"
                VerticalOptions="End"
                Margin="16, 0, 16, 28"
                Padding="20, 18"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="1"
                Stroke="#222C38"
                BackgroundColor="#1B232C">
            <Border.Shadow>
                <Shadow Brush="#080C10"
                        Offset="0, 8"
                        Radius="24"
                        Opacity="0.65" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">
                <!-- Overview Panel (Idle & Route Calculated) -->
                <VerticalStackLayout x:Name="OverviewPanel" Spacing="16">
                    <!-- Metrics Row: Big ETA on left, Distance on right -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label x:Name="EtaLabel"
                                   Text="-- دقیقه"
                                   FontFamily="SpaceGrotesk"
                                   FontSize="38"
                                   FontAttributes="Bold"
                                   TextColor="#EDEFF2" />
                            <Label x:Name="AlgorithmDetailsLabel"
                                   Text="مبدا و مقصد را انتخاب کنید"
                                   FontFamily="Manrope"
                                   FontSize="13"
                                   TextColor="#8B96A3" />
                        </VerticalStackLayout>

                        <Label x:Name="DistanceLabel"
                               Grid.Column="1"
                               Text=""
                               FontFamily="Manrope"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#EDEFF2"
                               VerticalOptions="Start"
                               Margin="0, 8, 0, 0" />
                    </Grid>

                    <!-- Amber delay/warning label -->
                    <Label x:Name="WarningLabel"
                           Text=""
                           FontFamily="Manrope"
                           FontSize="12"
                           TextColor="#E0A458"
                           IsVisible="False" />

                    <!-- Single Accent Action Button -->
                    <Button x:Name="FindRouteButton"
                            Text="مسیریابی"
                            FontFamily="Manrope"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#10151B"
                            BackgroundColor="#23A6A0"
                            CornerRadius="16"
                            HeightRequest="52"
                            Clicked="OnFindRouteClicked"
                            IsEnabled="False" />
                </VerticalStackLayout>

                <!-- Active Navigation Panel (Google Maps Style) -->
                <Grid x:Name="ActiveNavPanel"
                      ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="14"
                      VerticalOptions="Center"
                      IsVisible="False">
                    <!-- Exit Navigation Circular Button -->
                    <Button x:Name="ExitNavButton"
                            Grid.Column="0"
                            Text="✕"
                            FontFamily="Manrope"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#EDEFF2"
                            BackgroundColor="#26313E"
                            BorderColor="#334253"
                            BorderWidth="1"
                            CornerRadius="24"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            Clicked="OnExitNavClicked" />

                    <!-- Live Navigation ETA & Arrival -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label x:Name="NavEtaLabel"
                               Text="-- دقیقه"
                               FontFamily="SpaceGrotesk"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#23A6A0" />
                        <Label x:Name="NavDetailsLabel"
                               Text="-- km • --:--"
                               FontFamily="Manrope"
                               FontSize="13"
                               TextColor="#8B96A3" />
                    </VerticalStackLayout>

                    <!-- Vehicle Switcher Button -->
                    <Button x:Name="VehicleSwitchButton"
                            Grid.Column="2"
                            Text="🚗"
                            ToolTipProperties.Text="Switch 3D Car Model"
                            FontSize="20"
                            BackgroundColor="#26313E"
                            BorderColor="#334253"
                            BorderWidth="1"
                            CornerRadius="24"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            Clicked="OnVehicleSwitchClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
